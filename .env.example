# Backend only. Never put API keys or tokens in extension source code.
# Copy this file to .env.local and fill in credentials.

# Server
PORT=8787

# Generation settings
# Use auto to balance traffic across every fully configured provider.
# You can also force one provider: mock, gemini, mistral, cloudflare, or groq.
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=gemini,mistral,cloudflare,groq
# Relative request shares. Equal weights keep request counts approximately equal.
LLM_PROVIDER_WEIGHTS=gemini:1,mistral:1,cloudflare:1,groq:1
LLM_TOTAL_TIMEOUT_MS=25000
LLM_ATTEMPT_TIMEOUT_MS=9000
LLM_COOLDOWN_MS=30000
LLM_MAX_OUTPUT_TOKENS=384
LLM_TEMPERATURE=0.45

# Gemini
# Set LLM_MODEL_BASELINE to a Gemini model ID available to your account.
GEMINI_API_KEY=
LLM_MODEL_BASELINE=

# Legacy setting retained for compatibility. Prefer the provider-specific model variables above and below.
LLM_MODEL_FALLBACK=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512

# Cloudflare Workers AI
# Account ID is required in the Workers AI API URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Gemma reasoning tokens count toward this limit; keep it above the visible reply limit.
CLOUDFLARE_MAX_OUTPUT_TOKENS=768

# Groq
# Disable reasoning for short language tasks and JSON output.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_EFFORT=none
