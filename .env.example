# Backend only. Never put API keys or tokens in extension source code.
# Copy this file to .env.local and fill in credentials.

# Server
PORT=8787

# Generation settings
# Use auto to balance traffic across every fully configured provider.
# You can also force one provider: mock, gemini, mistral, cloudflare, or groq.
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=gemini,mistral,cloudflare,groq
# Relative request shares. Equal weights keep request counts approximately equal.
LLM_PROVIDER_WEIGHTS=gemini:1,mistral:1,cloudflare:1,groq:1
LLM_TOTAL_TIMEOUT_MS=25000
LLM_ATTEMPT_TIMEOUT_MS=9000
LLM_COOLDOWN_MS=30000
LLM_MAX_OUTPUT_TOKENS=384
LLM_TEMPERATURE=0.45

# Gemini
# Set LLM_MODEL_BASELINE to a Gemini model ID available to your account.
GEMINI_API_KEY=
LLM_MODEL_BASELINE=

# Legacy setting retained for compatibility. Prefer the provider-specific model variables above and below.
LLM_MODEL_FALLBACK=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512

# Cloudflare Workers AI
# Account ID is required in the Workers AI API URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Gemma reasoning tokens count toward this limit; keep it above the visible reply limit.
CLOUDFLARE_MAX_OUTPUT_TOKENS=768

# Groq
# Disable reasoning for short language tasks and JSON output.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_EFFORT=none

# Supabase Auth. The publishable key is public and is baked into the extension build;
# the api gateway uses the same pair to verify Bearer tokens (see docs/auth-setup.md).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set to 1 to require every generation request to carry a valid signed-in session.
AUTH_REQUIRED=0
# Optional quota gate on the gateway. "1" verifies tokens and consumes quota
# only for signed-in users; anonymous requests keep working.
ENFORCE_QUOTA=0
# Daily replies by account plan. 0 = unlimited.
FREE_DAILY_QUOTA=10
PREMIUM_DAILY_QUOTA=100

# Waffo Pancake payments. Keep the private key server-side and configure it as
# a Cloudflare Worker secret in production.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_ENVIRONMENT=prod
WAFFO_MONTHLY_PRODUCT_ID=
WAFFO_ANNUAL_PRODUCT_ID=
WAFFO_PRIVATE_KEY=
# Sentry error monitoring for the Cloudflare Worker (optional locally).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
