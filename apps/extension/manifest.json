{
  "key": "",
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.1.1",
  "description": "__MSG_description__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://api.verbia.henriz.dev/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.com/*",
    "https://www.outlook.com/*",
    "https://pthfyoejvlcwxboskrjr.supabase.co/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/verbia-logo.svg", "icons/verbia-horizontal-logo.svg", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.com/*", "https://www.outlook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-verbia": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "__MSG_openVerbiaDesc__"
    }
  }
}
