# Web (marketing site / account console). Copy to apps/web/.env.local.
# These point at the SAME Supabase project used by the Chrome extension
# (see root .env.local), so website accounts and extension accounts share one
# user identity, profile, and daily usage quota. Sessions themselves stay
# separate: the web keeps its session in localStorage, the extension in
# chrome.storage — the two never sync login state.

# Same values as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY at the repo root.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Verbia gateway used to read the signed-in account's usage (optional;
# defaults to https://api.verbia.henriz.dev).
NEXT_PUBLIC_VERBIA_API=
