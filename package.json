{
  "name": "verbia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "web:dev": "pnpm --filter @verbia/web dev",
    "web:build": "pnpm --filter @verbia/web build",
    "web:typecheck": "pnpm --filter @verbia/web typecheck",
    "api": "tsx --env-file=.env.local services/api/src/server.ts",
    "db:check": "node scripts/db-check.mjs",
    "api:mock": "LLM_PROVIDER=mock tsx services/api/src/server.ts",
    "api:dev": "wrangler dev",
    "api:deploy": "pnpm db:check && wrangler deploy --cwd /tmp --config \"$PWD/wrangler.jsonc\"",
    "api:deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.73.0",
    "@supabase/supabase-js": "^2.115.0",
    "@waffo/pancake-ts": "^0.19.1",
    "jose": "^6.2.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.35.0"
  }
}
