{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": { "@verbia/shared": ["packages/shared/src/index.ts"] }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "services/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
}
